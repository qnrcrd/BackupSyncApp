<Window x:Class="BackupSyncApp.Views.TutorialWindow"  
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"   
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:BackupSyncApp.Common"
        Title="{common:Localize Tutorial_WindowTitle}" 
        Height="500" Width="600"  
        ResizeMode="NoResize"  
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None"    
        AllowsTransparency="True">

    <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" 
                Text="{common:Localize Tutorial_Welcome_Title}"
                FontSize="20"
                FontWeight="Bold"
                Foreground="#2196F3"
                Margin="0,0,0,20"/>

            <!-- Контент слайда -->
            <Border Grid.Row="1" 
                Background="#E3F2FD" 
                CornerRadius="8" 
                Padding="30"
                Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="SlideTitle"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#1976D2"
                        Margin="0,0,0,10"/>
                    <TextBlock x:Name="SlideContent"
                        FontSize="14"
                        Foreground="#424242"
                        TextWrapping="Wrap"
                        MaxWidth="400"
                        LineHeight="24"/>
                </StackPanel>
            </Border>

            <!-- Навигация -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Индикатор прогресса -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot1" Width="10" Height="10" Fill="#2196F3" Margin="0,0,5,0"/>
                    <Ellipse x:Name="Dot2" Width="10" Height="10" Fill="#BDBDBD" Margin="0,0,5,0"/>
                    <Ellipse x:Name="Dot3" Width="10" Height="10" Fill="#BDBDBD"/>
                </StackPanel>

                <!-- Кнопка Назад -->
                <Button Grid.Column="1" 
                    x:Name="BtnPrev"
                    Content="{common:Localize Tutorial_Button_Prev}"
                    Style="{StaticResource ModernButton}"
                    Background="#BDBDBD"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="BtnPrev_Click"
                    IsEnabled="False"/>

                <!-- Кнопка Вперёд/Готово -->
                <Button Grid.Column="2" 
                    x:Name="BtnNext"
                    Content="{common:Localize Tutorial_ButtonText}"
                    Style="{StaticResource ModernButton}"
                    Width="100"
                    Click="BtnNext_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>